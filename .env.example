# Copy to .env.local and replace both values with the Neon connection strings.
# Use the pooled Neon URL for the application and the direct URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
WS_NO_BUFFER_UTIL=1

# Single administrator access. Generate a hash with: pnpm auth:hash-password
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
AUTH_SESSION_SECRET=

# 32 random bytes as 64 hex characters. Generate with: openssl rand -hex 32
MODEL_API_KEY_ENCRYPTION_KEY=
